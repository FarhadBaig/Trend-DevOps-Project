{
    "uid":  "complete-devops-guide",
    "title":  "Complete DevOps Deployment Guide",
    "tags":  [
                 "EKS",
                 "Kubernetes",
                 "DevOps",
                 "Monitoring"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "30s",
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Kubernetes Pods Running",
                       "type":  "stat",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum(kube_pod_status_phase{phase=\"Running\"})",
                                           "legendFormat":  "Running Pods",
                                           "refId":  "A"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  5,
                                       "w":  6,
                                       "x":  0,
                                       "y":  0
                                   }
                   },
                   {
                       "id":  2,
                       "title":  "Failed Pods",
                       "type":  "stat",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum(kube_pod_status_phase{phase=\"Failed\"})",
                                           "legendFormat":  "Failed Pods",
                                           "refId":  "A"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  5,
                                       "w":  6,
                                       "x":  6,
                                       "y":  0
                                   }
                   },
                   {
                       "id":  3,
                       "title":  "CPU Usage by Namespace",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m]))",
                                           "legendFormat":  "{{namespace}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  0
                                   }
                   },
                   {
                       "id":  4,
                       "title":  "Memory Usage by Namespace",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum by (namespace) (container_memory_working_set_bytes{container!=\"\",container!=\"POD\"})",
                                           "legendFormat":  "{{namespace}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  8
                                   }
                   },
                   {
                       "id":  5,
                       "title":  "Pod Restarts in Last 15 Minutes",
                       "type":  "timeseries",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[15m]))",
                                           "legendFormat":  "{{namespace}} / {{pod}}",
                                           "refId":  "A"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  8
                                   }
                   }
               ]
}